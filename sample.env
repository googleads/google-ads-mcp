# ==============================================================================
# Google Ads MCP Server - Environment Configuration
# Target: https://google-ads-mcp.comergent.ai/
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
MCP_TRANSPORT=streamable-http
GOOGLE_ADS_MCP_BASE_URL=https://google-ads-mcp.comergent.ai

# Google Cloud & Google Ads Credentials
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-manager-customer-id
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account-key.json

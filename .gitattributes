# Normalize text files in the repository.
* text=auto

# Keep source, configuration, documentation, and container files on LF.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
Dockerfile text eol=lf

# Shell scripts require LF in Linux and containers.
*.sh text eol=lf

# Keep Windows command files on CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never normalize binary assets.
*.png binary
*.jpg binary
*.gif binary
